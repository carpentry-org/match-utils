(doc MatchUtils
  "Utility macros built on top of `match`. Provides `let-match` for
pattern bindings with explicit fallback, and `defn-match` for
pattern-matching function definitions.")
(defmodule MatchUtils
  (hidden pairs)
  (defndynamic pairs [l]
    (if (< (length l) 2)
      '()
      (cons
        (list (collect-into (car l) list) (cadr l))
        (MatchUtils.pairs (cddr l)))))

  (hidden let-match-)
  (defndynamic let-match- [bindings then else]
    (cond
      (empty? bindings) then
      (= (length bindings) 1)
        (macro-error
          (list
            "malformed bindings in let-match: the number of forms must be even, but I found a trailing "
            (car bindings)))
      `(match %(cadr bindings)
        %(car bindings) %(MatchUtils.let-match- (cddr bindings) then else)
        _ %else)))

  (doc let-match "Pattern-binding form with an explicit fallback. Tries each
`pattern expression` pair in `bindings`; if every pattern matches,
evaluates `then` with the bindings in scope. If any pattern fails,
evaluates `else`. Both branches must have the same type, so the form
is well-typed regardless of body type.

```
(MatchUtils.let-match [(Maybe.Just x) (Array.nth &xs 0)]
  (IO.println &(fmt \"got %d\" x))
  (IO.println \"empty\"))
```

When invoked as a direct `defn` body, prefer the qualified form
`MatchUtils.let-match` over `(use MatchUtils)`. A Carp quirk causes
unqualified `use`-imported macros expanding to `match` to leak the
pattern variable into value-lookup.")
  (defmacro let-match [bindings then else]
    (MatchUtils.let-match- bindings then else))

  (hidden occurs?)
  (defndynamic occurs? [s form]
    (cond
      (= s form) true
      (list? form) (any? (fn [f] (MatchUtils.occurs? s f)) form)
      (array? form)
        (any? (fn [f] (MatchUtils.occurs? s f)) (collect-into form list))
      false))

  (hidden rotate)
  (defndynamic rotate [n l]
    (if (= n 0) l (MatchUtils.rotate (dec n) (cons-last (car l) (cdr l)))))

  (hidden wildcards)
  (defndynamic wildcards [n]
    (if (= n 0) '() (cons '_ (MatchUtils.wildcards (dec n)))))

  (hidden fresh)
  (defndynamic fresh [n]
    (if (= n 0) '() (cons (gensym) (MatchUtils.fresh (dec n)))))

  (hidden dotted-name?)
  (defndynamic dotted-name? [s]
    (cond
      (= (String.length s) 0) false
      (= (String.head s) ".") true
      (MatchUtils.dotted-name? (String.tail s))))

  ; Carp cannot bind a dotted symbol, so one in a pattern is a constructor.
  (hidden pattern-var?)
  (defndynamic pattern-var? [p]
    (and (symbol? p) (not (MatchUtils.dotted-name? (str p)))))

  (hidden ctor?)
  (defndynamic ctor? [p]
    (or (list? p) (and (symbol? p) (MatchUtils.dotted-name? (str p)))))

  (hidden ctor-head)
  (defndynamic ctor-head [p] (if (list? p) (car p) p))

  (hidden ctor-args)
  (defndynamic ctor-args [p] (if (list? p) (cdr p) '()))

  (hidden discriminant)
  (defndynamic discriminant [patterns]
    (if (MatchUtils.pattern-var? (car patterns))
      (inc (MatchUtils.discriminant (cdr patterns)))
      0))

  (hidden bind)
  (defndynamic bind [vars values body]
    (let [bindings (reduce
            (fn [acc p]
              (if (MatchUtils.occurs? (car p) body)
                (append acc (list (car p) (cadr p)))
                acc))
            '()
            (map cdr (zip quote vars values)))]
      (if (empty? bindings) body `(let %(collect-into bindings array) %body))))

  (hidden unhandled)
  (defndynamic unhandled [name]
    `(do (println* %(str "Unhandled case in " name)) (bottom)))

  (hidden constructors)
  (defndynamic constructors [rows]
    (reduce
      (fn [acc row]
        (let [p (caar row)]
          (if (and (MatchUtils.ctor? p)
                   (not
                     (any?
                       (fn [ctor] (= (car ctor) (MatchUtils.ctor-head p)))
                       acc)))
            (cons-last
              (list (MatchUtils.ctor-head p) (length (MatchUtils.ctor-args p)))
              acc)
            acc)))
      '()
      rows))

  (hidden literals)
  (defndynamic literals [rows]
    (reduce
      (fn [acc row]
        (let [p (caar row)]
          (if (or (symbol? p) (any? (fn [lit] (= lit p)) acc))
            acc
            (cons-last p acc))))
      '()
      rows))

  (hidden specialize)
  (defndynamic specialize [rows constructor arity whole]
    (reduce
      (fn [acc row]
        (let [patterns (car row)
              body (cadr row)
              p (car patterns)]
          (cond
            (MatchUtils.pattern-var? p)
              (cons-last
                (list
                  (append (MatchUtils.wildcards arity) (cdr patterns))
                  (MatchUtils.bind (list p) (list whole) body))
                acc)
            (and (MatchUtils.ctor? p) (= (MatchUtils.ctor-head p) constructor))
              (cons-last
                (list (append (MatchUtils.ctor-args p) (cdr patterns)) body)
                acc)
            acc)))
      '()
      rows))

  (hidden specialize-literal)
  (defndynamic specialize-literal [rows literal whole]
    (reduce
      (fn [acc row]
        (let [patterns (car row)
              body (cadr row)
              p (car patterns)]
          (cond
            (MatchUtils.pattern-var? p)
              (cons-last
                (list (cdr patterns)
                      (MatchUtils.bind (list p) (list whole) body))
                acc)
            (= p literal) (cons-last (list (cdr patterns) body) acc)
            acc)))
      '()
      rows))

  (hidden defaults)
  (defndynamic defaults [rows whole]
    (reduce
      (fn [acc row]
        (let [patterns (car row)
              p (car patterns)]
          (if (MatchUtils.pattern-var? p)
            (cons-last
              (list (cdr patterns)
                    (MatchUtils.bind (list p) (list whole) (cadr row)))
              acc)
            acc)))
      '()
      rows))

  (hidden needs-whole?)
  (defndynamic needs-whole? [rows]
    (any?
      (fn [row]
        (let [p (caar row)]
          (and (MatchUtils.pattern-var? p) (MatchUtils.occurs? p (cadr row)))))
      rows))

  (hidden emit-match)
  (defndynamic emit-match [name scrutinee others rows]
    (let [whole (if (MatchUtils.needs-whole? rows) (gensym) '_)
          fallback (gensym)
          arms (reduce
            (fn [acc ctor]
              (let [subs (MatchUtils.fresh (cadr ctor))]
                (append acc
                        (list (cons (car ctor) subs)
                              (MatchUtils.compile name
                                                  (append subs others)
                                                  (MatchUtils.specialize rows
                                                                         (car ctor)
                                                                         (cadr ctor)
                                                                         whole))))))
            '()
            (MatchUtils.constructors rows))
          others-rows (MatchUtils.defaults rows fallback)
          tree `(match %scrutinee
            %@arms %fallback
            %(if (empty? others-rows)
              (MatchUtils.unhandled name)
              (MatchUtils.compile name others others-rows)))]
      (if (= whole '_) tree `(let [%whole @&%scrutinee] %tree))))

  (hidden emit-case)
  (defndynamic emit-case [name scrutinee others rows]
    (let [arms (reduce
            (fn [acc lit]
              (append acc
                      (list lit
                            (MatchUtils.compile name
                                                others
                                                (MatchUtils.specialize-literal rows
                                                                               lit
                                                                               scrutinee)))))
            '()
            (MatchUtils.literals rows))
          others-rows (MatchUtils.defaults rows scrutinee)]
      `(case %scrutinee
             %@arms
             %(if (empty? others-rows)
               (MatchUtils.unhandled name)
               (MatchUtils.compile name others others-rows)))))

  (hidden compile)
  (defndynamic compile [name scrutinees rows]
    (cond
      (empty? rows) (MatchUtils.unhandled name)
      (empty? scrutinees) (cadr (car rows))
      (all? MatchUtils.pattern-var? (caar rows))
        (MatchUtils.bind (caar rows) scrutinees (cadr (car rows)))
      (let [col (MatchUtils.discriminant (caar rows))
            ordered (MatchUtils.rotate col scrutinees)
            aligned (map
              (fn [row] (list (MatchUtils.rotate col (car row)) (cadr row)))
              rows)]
        (if (any? MatchUtils.ctor? (map caar aligned))
          (MatchUtils.emit-match name (car ordered) (cdr ordered) aligned)
          (MatchUtils.emit-case name (car ordered) (cdr ordered) aligned)))))

  (hidden arities-of)
  (defndynamic arities-of [paired]
    (reduce
      (fn [acc p]
        (let [ar (length (car p))]
          (if (any? (fn [x] (= x ar)) acc) acc (cons-last ar acc))))
      '()
      paired))

  (hidden rows-with-arity)
  (defndynamic rows-with-arity [paired ar]
    (filter (fn [p] (= (length (car p)) ar)) paired))

  (hidden emit-arity)
  (defndynamic emit-arity [name paired]
    (if (and (= (length paired) 1) (all? MatchUtils.pattern-var? (caar paired)))
      (let [row (car paired)]
        `(defn %name %(collect-into (car row) array) %(cadr row)))
      (let [args (map (fn [_] (gensym)) (caar paired))]
        `(defn %name %(collect-into args array)
          %(MatchUtils.compile name args paired)))))

  (hidden emit-dispatcher)
  (defndynamic emit-dispatcher [name arities]
    (let [branches (reduce
            (fn [acc ar]
              (let [per-arity-name (Symbol.concat [name
                                                   '-
                                                   (Symbol.from (str ar))])]
                (append acc
                        (list `(= (length args) %ar)
                              (list 'quote per-arity-name)))))
            '()
            arities)]
      `(defmacro %name [:rest args]
        (cons
          (cond
            %@branches
              (macro-error %(str "defn-match: no arity version of " name)))
          args))))

  (doc defn-match
    "Defines a pattern-matching function. Each row is a list of patterns
followed by a body.

```
(deftype Num
  (I [Int])
  (D [Double]))

(MatchUtils.defn-match add-num
  [(Num.I x) (Num.I y)] (Num.I (+ x y))
  [(Num.D x) (Num.D y)] (Num.D (+ x y))
  [(Num.D x) (Num.I y)] (Num.D (+ x (from-int y)))
  [(Num.I x) (Num.D y)] (Num.D (+ (from-int x) y)))
```

Rows are tried in source order and the first row that matches every
column wins, so a variable pattern acts as a catch-all for its column
without hiding later rows that the catch-all row itself fails to
match:

```
(MatchUtils.defn-match pair-or
  [(Maybe.Just a) (Maybe.Just b)] (+ a b)
  [x              y]              0)

(pair-or (Maybe.Just 1) (Maybe.Nothing))  ; => 0
```

A row whose patterns are all variables makes every later row
unreachable, since it matches any input. Unreachable rows are dropped
rather than compiled, so they no longer constrain the argument types.

A bare symbol in pattern position is a pattern variable, with one
exception: a qualified symbol such as `Maybe.Nothing` is a nullary
constructor, since Carp cannot bind a dotted symbol anyway. An
unqualified nullary constructor is indistinguishable from a variable
here, so under `(use Maybe)` it must be written `(Nothing)`:

```
(MatchUtils.defn-match take-just
  [Maybe.Nothing]  0     ; nullary constructor
  [(Maybe.Just n)] n)

(MatchUtils.defn-match shadowed
  [Nothing]        0     ; a VARIABLE named Nothing — catch-all
  [(Maybe.Just n)] n)    ; unreachable
```

When all rows have the same arity, expands to a single `defn` with
nested match dispatch. `add-num` above is a plain function, first-class
and usable in higher-order contexts.

When rows have differing arities, expands to one `defn` per arity
named `name-0`, `name-1`, …, plus a dispatching macro `name` that
picks the right arity at the call site:

```
(MatchUtils.defn-match count
  []                         0
  [(Maybe.Just _)]           1
  [(Maybe.Just _) (Maybe.Just _)] 2)

; call sites: (count), (count m), (count m1 m2)
; first-class per arity: count-0, count-1, count-2
;   (Array.map count-1 maybes)   -- works
;   (Array.map count m)          -- does NOT work, count is a macro
```

Inputs no row covers print `Unhandled case in name` and abort. The
rows are not checked for exhaustiveness at compile time.

When invoked as a direct `defn` body, prefer the qualified form
`MatchUtils.defn-match` over `(use MatchUtils)` for the same reason
documented on `let-match`.")
  (defmacro defn-match [name :rest forms]
    (cond
      (empty? forms)
        (macro-error
          "defn-match must contain at least one pair of arguments and body after the name.")
      (= (imod (length forms) 2) 1)
        (macro-error
          "defn-match must contain pairs of arguments and body after the name, but got an odd number of forms.")
      (let-do [paired (MatchUtils.pairs forms)
               arities (MatchUtils.arities-of paired)]
        (if (= (length arities) 1)
          ; all rows share one arity → single defn
          (MatchUtils.emit-arity name paired)
          ; multi-arity → (do per-arity-defn... dispatcher-macro)
          `(do
            %@(map
              (fn [ar]
                (MatchUtils.emit-arity
                  (Symbol.concat [name '- (Symbol.from (str ar))])
                  (MatchUtils.rows-with-arity paired ar)))
              arities)
            %(MatchUtils.emit-dispatcher name arities)))))))
